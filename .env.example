# Copie para ~/.summa/.env ou para .env na raiz do projeto

# --- IA ---
# Provedor: openai | anthropic (auto-detecta pela key disponível)
SUMMA_AI_PROVIDER=openai

# Modelo (padrão: o4-mini para openai)
SUMMA_AI_MODEL=o4-mini

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic (alternativa)
# ANTHROPIC_API_KEY=sk-ant-...

# Endpoint compatível (Ollama local, etc.)
# SUMMA_AI_BASE_URL=http://localhost:11434/v1

# --- Idioma da conversa com a IA ---
# en, pt-BR, pt-PT, es, fr, de, it
SUMMA_LANGUAGE=pt-BR

# --- Dados ---
# Diretório de dados (opcional)
# SUMMA_HOME=~/.summa
